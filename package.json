{
  "name": "jira-ctrf",
  "version": "0.0.8",
  "description": "Create Jira issues with test results from popular testing frameworks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "test": "jest",
    "test:compile": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --ext .ts --fix",
    "lint-check": "eslint . --ext .ts",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "all": "npm run build && npm run lint && npm run format"
  },
  "bin": {
    "jira-ctrf": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctrf-io/jira-test-reporter.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://ctrf.io",
  "files": [
    "dist/",
    "README.md"
  ],
  "author": "Matthew Poulton-White",
  "license": "MIT",
  "dependencies": {
    "ctrf": "0.2.0",
    "glob": "13.0.6",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "@types/yargs": "17.0.35",
    "jest": "30.4.2",
    "jest-ctrf-json-reporter": "0.0.11",
    "prettier": "3.8.3",
    "ts-jest": "29.4.11",
    "typescript": "6.0.3"
  }
}
