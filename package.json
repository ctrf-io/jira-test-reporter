{
	"name": "jira-ctrf",
	"version": "0.0.9-next.0",
	"description": "Create Jira issues with test results from popular testing frameworks",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsup",
		"build:check": "tsc -p . --noEmit",
		"build:watch": "tsup --watch",
		"clean": "rm -rf dist && rm -rf coverage && rm -rf ctrf",
		"test": "npm run build && vitest run",
		"test:watch": "vitest",
		"test:coverage": "npm run build && vitest run --coverage",
		"test:compile": "tsc -p tsconfig.test.json --noEmit",
		"lint": "biome lint --write . --unsafe",
		"lint-check": "npm run lint:check",
		"format": "biome format --write .",
		"format-check": "npm run format:check",
		"all": "npm run build:check && npm run lint:check && npm run format:check && npm run test:coverage && npm run build",
		"lint:check": "biome lint .",
		"format:check": "biome format .",
		"check": "biome check ."
	},
	"bin": {
		"jira-ctrf": "./dist/cli.js"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ctrf-io/jira-test-reporter.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"homepage": "https://ctrf.io",
	"files": [
		"dist/",
		"README.md"
	],
	"author": "Matthew Poulton-White",
	"license": "MIT",
	"dependencies": {
		"ctrf": "0.2.1",
		"glob": "13.0.6",
		"yargs": "18.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@d2t/vitest-ctrf-json-reporter": "1.3.0",
		"@types/node": "26.1.2",
		"@types/yargs": "17.0.35",
		"@vitest/coverage-v8": "4.1.8",
		"tsup": "8.5.1",
		"typescript": "6.0.3",
		"vitest": "4.1.8"
	}
}
